# Copie para .env e ajuste. Em produção (Render), defina estas variáveis no painel.
PORT=3000
# Gere um valor longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Senha do usuário "admin" criado na primeira execução (se vazio, usa a senha de demonstração do seed)
ADMIN_SENHA=
# Origens permitidas para CORS, separadas por vírgula (vazio = qualquer origem)
CORS_ORIGIN=
# Caminho do arquivo de dados (padrão: server/data/db.json)
# DB_PATH=
